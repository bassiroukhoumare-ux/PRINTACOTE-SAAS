{
  "functions": {
    "api/*.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/actualites",
      "has": [
        {
          "type": "query",
          "key": "article"
        }
      ],
      "destination": "/api/actualites"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
